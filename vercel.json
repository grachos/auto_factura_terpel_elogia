{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/web",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    },
    "api/silog-waf.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__path=/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

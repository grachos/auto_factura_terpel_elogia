# Copiar a .env (nunca versionar .env). Sin valores reales en este archivo.

# --- Modo de ejecución -------------------------------------------------
# AUTH_MODE: demo (usuarios ficticios locales) | supabase (JWT de Supabase Auth)
AUTH_MODE=demo
# Solo modo demo: secreto para firmar tokens locales (si se omite se genera uno al arrancar)
DEMO_JWT_SECRET=
PORT=3000

# --- Origen de correo ----------------------------------------------------
# MAIL_SOURCE: mock (datos ficticios) | graph (Exchange Online vía Microsoft Graph)
MAIL_SOURCE=mock
MAIL_MAILBOX=autorizaciones-terpel@empresa.example
MAIL_ALLOWED_SENDER=flota@informacion.terpel.com
MAIL_SUBJECT_PATTERN=AUTORIZACION PAGO TERPEL - Facturacion de servicio
MAIL_REQUIRE_DMARC_PASS=false
# transport_number | transport_expense
BUSINESS_KEY_STRATEGY=transport_number

# --- Microsoft Graph (solo si MAIL_SOURCE=graph) ---------------------------
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
# Certificado (producción): huella SHA-1 y clave privada PEM (ruta o contenido con \n)
GRAPH_CLIENT_CERT_THUMBPRINT=
GRAPH_CLIENT_CERT_PRIVATE_KEY_PATH=
GRAPH_CLIENT_CERT_PRIVATE_KEY=
# Secreto corto (solo pruebas, si TI lo autoriza)
GRAPH_CLIENT_SECRET=
# Segundo buzón NO autorizado para la prueba negativa de graph:check
GRAPH_CHECK_DENIED_MAILBOX=

# --- Base de datos y Storage ---------------------------------------------------
# Sin DATABASE_URL se usa PGlite embebido en .data/pglite (demo/local)
DATABASE_URL=
# STORAGE_DRIVER: fs (carpeta .data/storage) | supabase
STORAGE_DRIVER=fs
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Verificación de JWT: HS256 con secreto, o JWKS (proyectos con claves asimétricas)
SUPABASE_JWT_SECRET=
# STORAGE_DRIVER=db guarda los Excel en PostgreSQL (tabla export_blobs) y los sirve por /api/files con URL firmada.
FILES_SIGNING_SECRET=
# Opcional: restringe qué cuentas pueden reenviar autorizaciones al buzón (separadas por coma). Vacío = cualquiera
# mientras el "De:" citado sea el remitente de Terpel. Solo se usa al crear la configuración del buzón;
# después se cambia en la tabla mail_configs (allowed_forwarders).
MAIL_ALLOWED_FORWARDERS=

# --- Fase 2: Silogtran (SOLO LECTURA; solo servidor, nunca en el navegador) ---------
# URL base de la API (sin parámetros). Con AUTH_MODE=demo y sin estas variables se usa un Silogtran simulado.
SILOG_BASE_URL=
SILOG_USER=
SILOG_PASSWORD=
# NIT de Terpel (valor por defecto 830095213; editable luego en Parámetros)
SILOG_TERPEL_NIT=

# --- Usuarios y credenciales (solo servidor) ---------------------------------------
# Clave AES-256-GCM para cifrar contraseñas de Silogtran guardadas: 64 caracteres hexadecimales
# (generar con: openssl rand -hex 32). Sin ella no se pueden guardar credenciales.
ENCRYPTION_KEY=
# Secreto (mínimo 32 caracteres aleatorios) que firma los tokens del ingreso con usuario de Silogtran
# (generar con: openssl rand -base64 48). Sin él el ingreso con Silogtran no está disponible.
APP_SESSION_SECRET=

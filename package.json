{
  "name": "auto-factura-terpel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AutoFactura Terpel - Fase 1: importar correos de autorización, Excel y persistencia",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "demo:twice": "tsx scripts/demo-twice.ts",
    "graph:check": "tsx --env-file-if-exists=.env scripts/graph-check.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "demo": "npm run build && AUTH_MODE=demo MAIL_SOURCE=mock npm start"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.2",
    "@fastify/static": "^8.0.4",
    "@sparticuz/chromium": "^153.0.0",
    "@supabase/supabase-js": "^2.47.10",
    "cheerio": "^1.2.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "luxon": "^3.5.0",
    "node-html-parser": "^7.0.1",
    "pg": "^8.13.1",
    "puppeteer-core": "^25.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "1.63.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
